# scripts/.env にコピーして使います（.env は Git に入りません）
# RIDE THE WORLD（micromobility-news）と同じSparkを使うなら、そちらの scripts/.env をそのままコピーしてもOK

# OpenAI互換APIのURL（vLLM / SGLang / llama.cpp / Ollama など。末尾は /v1）
LLM_BASE_URL=http://spark-1:8000/v1
# サーバー側のモデル名（curl $LLM_BASE_URL/models で確認できます。例: GLM-5.3-Flash を載せている名前）
LLM_MODEL=your-model-name
# APIキー（サーバーに設定している場合）
LLM_API_KEY=

# 1 なら JSONモード(response_format=json_object)を使う。サーバーが未対応なら 0
LLM_JSON_MODE=1
# 思考(thinking)で遅い・JSONが崩れる場合は思考をオフに（vLLM/SGLangのGLM・Qwen系の例）
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
LLM_TIMEOUT=900

# ニュース検索: ddgs（DuckDuckGo News、既定） / searxng / none（RSS・Atomのみ）
SEARCH_BACKEND=ddgs
# SEARXNG_URL=http://spark-1:8888
